@font-face {
    font-family: 'OnePieceReal';
    src: url('https://files.fontsme.com/o/107/12107/file/one piece font.ttf') format('truetype');
}

* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: transparent;
}

.wanted-container {
    opacity: 0;
    display: none;
    position: absolute;
    top: 5%;
    left: 5%;
    z-index: 999;
    will-change: opacity, transform;
}

.wanted-container.show {
    display: block;
    animation: onePieceWantedSnap 6s ease forwards;
}

.poster-wrapper {
    position: relative;
    width: 420px;
    height: auto;
}

.wanted-bg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 25px 35px rgba(0,0,0,0.9));
}

/* АВАТАРКА: чітко по твоїй чорній зоні */
.follower-avatar {
    position: absolute !important;
    top: 21% !important;   
    left: 7.9% !important;  
    width: 85.2% !important;  
    height: 42.6% !important; 
    object-fit: cover !important;
    z-index: 2 !important;
}

.poster-info {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 3 !important;
    pointer-events: none !important;
}

/* НІК: оригінальний шрифт з аніме */
.follower-name {
    position: absolute !important;
    top: 73% !important; 
    left: 0 !important;
    width: 100% !important;
    text-align: center !important;
    font-size: 50px !important;
    font-weight: 900 !important;
    color: #372003 !important;
    letter-spacing: 3px !important;
    font-family: 'OnePieceReal', sans-serif !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    padding: 0 45px !important;
}

/* СУМА: оригінальний шрифт з аніме */
.bounty-amount {
    position: absolute !important;
    top: 84% !important; 
    left: 0 !important;
    width: 100% !important;
    text-align: center !important;
    font-size: 40px !important;
    font-weight: 900 !important;
    color: #321c02 !important
    letter-spacing: 2.5px !important;
    font-family: 'OnePieceReal', sans-serif !important;
    white-space: nowrap !important;
    padding: 0 40px !important;
}

@keyframes onePieceWantedSnap {
    0% {
        opacity: 0;
        transform: scale(2) rotate(-8deg) translateY(-60px);
    }
    12% {
        opacity: 1;
        transform: scale(0.96) rotate(2deg) translateY(5px);
    }
    18% {
        transform: scale(1.01) rotate(-1deg) translateY(0);
    }
    22% {
        transform: scale(1) rotate(0deg) translateY(0);
    }
    85% {
        opacity: 1;
        transform: scale(1) rotate(0deg) translateY(0);
    }
    100% {
        opacity: 0;
        transform: scale(0.85) rotate(5deg) translateY(30px);
    }
}
